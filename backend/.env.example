# Banco de dados (Neon Postgres) - use a connection string com "sslmode=require"
DATABASE_URL="postgresql://user:password@ep-example.neon.tech/esporte_total?sslmode=require"

# Ambiente
NODE_ENV="development"
PORT=3333

# Origem(ns) permitida(s) para CORS (separadas por vírgula). Ex: produção + preview local.
CORS_ORIGIN="http://localhost:5173"

# Segredo usado para assinar os JWTs de sessão do admin. Gere um valor aleatório forte, ex:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-este-valor-por-uma-string-aleatoria-longa"

# Credenciais do admin criadas pelo script de seed (rodar apenas uma vez, depois trocar a senha)
ADMIN_EMAIL="admin@esportetotal.com.br"
ADMIN_PASSWORD="troque-esta-senha-antes-de-ir-para-producao"
ADMIN_NOME="Administrador"

# Nominatim (OpenStreetMap) exige um contato válido no User-Agent das requisições
NOMINATIM_CONTACT_EMAIL="contato@esportetotal.com.br"

# Cloudinary (upload de fotos das unidades) - opcional, deixe em branco para usar URLs manuais
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

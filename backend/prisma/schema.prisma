generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        String      @id @default(cuid())
  nome      String
  email     String?
  telefone  String?
  ativa     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  usuarios  AdminUser[]
  unidades  Unidade[]

  @@map("empresas")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nome         String
  role         String   @default("owner")
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([empresaId])
  @@map("admin_users")
}

model Modalidade {
  id        String             @id @default(cuid())
  nome      String             @unique
  slug      String             @unique
  descricao String?
  icone     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  quadras   QuadraModalidade[]
  reservas  Reserva[]

  @@map("modalidades")
}

model Unidade {
  id                   String   @id @default(cuid())
  empresaId            String
  empresa              Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                 String
  slug                 String   @unique
  descricao            String?
  telefone             String?
  whatsapp             String?
  email                String?
  site                 String?
  endereco             String
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String
  estado               String
  cep                  String?
  latitude             Float?
  longitude            Float?
  horarioFuncionamento String?
  horaAbertura         String?
  horaFechamento       String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  quadras              Quadra[]
  fotos                Foto[]

  @@index([cidade])
  @@index([estado])
  @@index([ativo])
  @@index([empresaId])
  @@map("unidades")
}

// Uma unidade (endereco/complexo) pode ter varias quadras - cada uma
// agendada de forma independente, com seu proprio nome e modalidades/precos.
// Isso permite que 2 quadras estejam locadas no mesmo horario e uma terceira
// continue disponivel.
model Quadra {
  id          String             @id @default(cuid())
  unidadeId   String
  unidade     Unidade            @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  nome        String
  ativa       Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  modalidades QuadraModalidade[]
  reservas    Reserva[]

  @@index([unidadeId])
  @@map("quadras")
}

model QuadraModalidade {
  quadraId     String
  modalidadeId String
  precoHora    Float?
  quadra       Quadra     @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  modalidade   Modalidade @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)

  @@id([quadraId, modalidadeId])
  @@map("quadra_modalidades")
}

model Reserva {
  id                  String     @id @default(cuid())
  quadraId            String
  quadra              Quadra     @relation(fields: [quadraId], references: [id], onDelete: Cascade)
  modalidadeId        String
  modalidade          Modalidade @relation(fields: [modalidadeId], references: [id])
  data                DateTime
  horarios            String[]
  nomeSolicitante     String
  telefoneSolicitante String
  valorTotal          Float?
  valorSinal          Float?
  status              String     @default("aguardando_pagamento")
  pixPaymentId        String?
  pixQrCode           String?
  pixCopiaCola        String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([quadraId, data])
  @@index([pixPaymentId])
  @@map("reservas")
}

model Foto {
  id        String   @id @default(cuid())
  unidadeId String
  url       String
  publicId  String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  unidade   Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([unidadeId])
  @@map("fotos")
}

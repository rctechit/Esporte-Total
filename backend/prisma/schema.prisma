generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        String      @id @default(cuid())
  nome      String
  email     String?
  telefone  String?
  ativa     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  usuarios  AdminUser[]
  unidades  Unidade[]

  @@map("empresas")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nome         String
  role         String   @default("owner")
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([empresaId])
  @@map("admin_users")
}

model Modalidade {
  id        String               @id @default(cuid())
  nome      String               @unique
  slug      String               @unique
  descricao String?
  icone     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  unidades  UnidadeModalidade[]
  reservas  Reserva[]

  @@map("modalidades")
}

model Unidade {
  id                   String               @id @default(cuid())
  empresaId            String
  empresa              Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                 String
  slug                 String               @unique
  descricao            String?
  telefone             String?
  whatsapp             String?
  email                String?
  site                 String?
  endereco             String
  numero               String?
  complemento          String?
  bairro               String?
  cidade               String
  estado               String
  cep                  String?
  latitude             Float?
  longitude            Float?
  horarioFuncionamento String?
  horaAbertura         String?
  horaFechamento       String?
  ativo                Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  modalidades          UnidadeModalidade[]
  fotos                Foto[]
  reservas             Reserva[]

  @@index([cidade])
  @@index([estado])
  @@index([ativo])
  @@index([empresaId])
  @@map("unidades")
}

model UnidadeModalidade {
  unidadeId    String
  modalidadeId String
  precoHora    Float?
  unidade      Unidade    @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  modalidade   Modalidade @relation(fields: [modalidadeId], references: [id], onDelete: Cascade)

  @@id([unidadeId, modalidadeId])
  @@map("unidade_modalidades")
}

model Reserva {
  id                  String     @id @default(cuid())
  unidadeId           String
  modalidadeId        String
  data                DateTime
  horarios            String[]
  nomeSolicitante     String
  telefoneSolicitante String
  valorTotal          Float?
  valorSinal          Float?
  status              String     @default("aguardando_pagamento")
  pixPaymentId        String?
  pixQrCode           String?
  pixCopiaCola        String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  unidade             Unidade    @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  modalidade          Modalidade @relation(fields: [modalidadeId], references: [id])

  @@index([unidadeId, data])
  @@index([pixPaymentId])
  @@map("reservas")
}

model Foto {
  id        String   @id @default(cuid())
  unidadeId String
  url       String
  publicId  String?
  ordem     Int      @default(0)
  createdAt DateTime @default(now())
  unidade   Unidade  @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([unidadeId])
  @@map("fotos")
}
